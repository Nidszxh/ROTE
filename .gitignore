# Python
__pycache__/
*.py[cod]

# Tooling artefacts (pytest, pytest-cov, ruff)
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Environment: `uv venv .venv`. There is no build backend, so the documented
# `uv pip install -r pyproject.toml --extra dev` never builds this project; these
# rules only catch the leftovers of an accidental `pip install -e .`.
.venv/
*.egg-info/
build/
dist/

# Notebooks (PROPOSAL.md section 1.1)
.ipynb_checkpoints/

# --- Data: never commit FI-2010 (licence terms: data/README.md) ---
# This rule is the ONLY guard against committing the dataset: there is no
# pre-commit size hook and no CI. Verify with
# `git check-ignore -v data/raw/<file>` before adding data.
/data/raw/*
!/data/raw/.gitkeep
/data/processed/

# --- Run caches and bulk intermediates ---
# results/tables/, results/figures/ and results/runs/<run_id>/run_manifest.json
# are deliberately NOT ignored: they are the evidence behind every claim.
/results/runs/**/cache/
/results/runs/**/*.parquet
/results/runs/**/*.npz
/results/runs/**/*.pkl

# Editors and OS
.vscode/
.idea/
.DS_Store
