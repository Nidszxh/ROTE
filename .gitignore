# Python
__pycache__/
*.py[cod]

# Tooling artefacts (pytest, pytest-cov, ruff)
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Environment: `uv venv .venv`. There is no build backend, so the documented
# `uv pip install -r pyproject.toml --extra dev` never builds this project; these
# rules only catch the leftovers of an accidental `pip install -e .`.
.venv/
*.egg-info/
build/
dist/
# uv.lock is intentionally NOT ignored: it is the reproducibility record for the
# pinned environment and belongs in version control if it is ever generated.

# Secrets and local overrides. OpenCode denies agent reads of `.env*` by
# default; these rules are what stops them being committed.
.env
.env.*
!.env.example

# Notebooks (PROPOSAL.md section 1.1)
.ipynb_checkpoints/
# Streamlit credentials, if the UI is ever configured for a remote deployment.
.streamlit/secrets.toml

# --- Data: never commit FI-2010 (licence terms: data/README.md) ---
# This rule is the ONLY guard against committing the dataset: there is no
# pre-commit size hook and no CI. Verify with
# `git check-ignore -v data/raw/<file>` before adding data.
/data/raw/*
!/data/raw/.gitkeep
/data/processed/
# The in-repo convenience symlink `data/raw/FI-2010 -> ~/data/FI-2010` is already
# covered by `/data/raw/*` above. Note that `git check-ignore -v` on a path
# *through* the symlink fails with "beyond a symbolic link"; check the link itself.

# --- Run caches and bulk intermediates ---
# results/tables/, results/figures/ and results/runs/<run_id>/run_manifest.json
# are deliberately NOT ignored: they are the evidence behind every claim.
/results/runs/**/cache/
/results/runs/**/*.parquet
/results/runs/**/*.npz
/results/runs/**/*.pkl

# Editors, OS and merge leftovers
.vscode/
.idea/
.DS_Store
Thumbs.db
*.orig
*.rej
*~
